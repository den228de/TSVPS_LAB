
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // 1. Получаем остатки товаров на выбранном складе

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Остатки.Номенклатура КАК Номенклатура,
    |   Остатки.КоличествоОстаток КАК Остаток
    |ИЗ
    |   РегистрНакопления.ОстаткиТоваров.Остатки(
    |       ,
    |       Склад = &Склад
    |   ) КАК Остатки";

    Запрос.УстановитьПараметр("Склад", Склад);

    ТаблицаОстатков = Запрос.Выполнить().Выгрузить();

    // 2. Проверяем количество каждого товара
    // Суммируем повторяющиеся строки документа

    Для Каждого СтрокаТовара Из Товары Цикл

        Если Не ЗначениеЗаполнено(
            СтрокаТовара.Номенклатура
        ) Тогда
            Продолжить;
        КонецЕсли;

        КоличествоВДокументе = 0;

        Для Каждого СтрокаПроверки Из Товары Цикл

            Если СтрокаПроверки.Номенклатура =
                СтрокаТовара.Номенклатура Тогда

                КоличествоВДокументе =
                    КоличествоВДокументе
                    + СтрокаПроверки.Количество;

            КонецЕсли;

        КонецЦикла;

        // Не проверяем один товар повторно

        УжеПроверен = Ложь;

        Для Каждого СтрокаПредыдущая Из Товары Цикл

            Если СтрокаПредыдущая = СтрокаТовара Тогда
                Прервать;
            КонецЕсли;

            Если СтрокаПредыдущая.Номенклатура =
                СтрокаТовара.Номенклатура Тогда

                УжеПроверен = Истина;
                Прервать;

            КонецЕсли;

        КонецЦикла;

        Если УжеПроверен Тогда
            Продолжить;
        КонецЕсли;

        Остаток = 0;

        Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл

            Если СтрокаОстатка.Номенклатура =
                СтрокаТовара.Номенклатура Тогда

                Остаток = СтрокаОстатка.Остаток;
                Прервать;

            КонецЕсли;

        КонецЦикла;

        Если КоличествоВДокументе > Остаток Тогда

            Сообщить(
                "Недостаточно товара: "
                + Строка(СтрокаТовара.Номенклатура)
                + Символы.ПС
                + "Склад: " + Строка(Склад)
                + Символы.ПС
                + "Остаток: " + Строка(Остаток)
                + Символы.ПС
                + "Требуется: "
                + Строка(КоличествоВДокументе)
            );

            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЦикла;

    // 3. Формируем движения расхода

    Движения.ОстаткиТоваров.Записывать = Истина;

    Для Каждого СтрокаТовара Из Товары Цикл

        Движение = Движения.ОстаткиТоваров.Добавить();

        Движение.Период = Дата;

        Движение.ВидДвижения =
            ВидДвиженияНакопления.Расход;

        Движение.Номенклатура =
            СтрокаТовара.Номенклатура;

        Движение.Склад = Склад;

        Движение.Количество =
            СтрокаТовара.Количество;

    КонецЦикла;

КонецПроцедуры
