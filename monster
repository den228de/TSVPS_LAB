
Функция ПолучитьОстаток(Товар)

    Если Товар = Неопределено Тогда
        Возврат 0;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
    |ИЗ
    |   РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
    |ГДЕ
    |   Остатки.Номенклатура = &Товар";

    Запрос.УстановитьПараметр("Товар", Товар);

    Результат = Запрос.Выполнить().Выбрать();

    Если Результат.Следующий() Тогда
        Возврат Результат.Остаток;
    КонецЕсли;

    Возврат 0;

КонецФункции


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Для Каждого СтрокаТовара Из Товары Цикл

        Остаток = ПолучитьОстаток(
            СтрокаТовара.Номенклатура
        );

        Если СтрокаТовара.Количество > Остаток Тогда

            Сообщить(
                "Недостаточно товара: "
                + СтрокаТовара.Номенклатура
                + ". Остаток: "
                + Строка(Остаток)
                + ". Требуется: "
                + Строка(СтрокаТовара.Количество)
            );

            Отказ = Истина;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
