Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Для Каждого СтрокаТовара Из Товары Цикл

        КоличествоНаСкладе = 0;

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   СУММА(Товары.Количество) КАК Количество
        |ИЗ
        |   Документ.ПоступлениеТоваров.Товары КАК Товары
        |ГДЕ
        |   Товары.Номенклатура = &Номенклатура";

        Запрос.УстановитьПараметр(
            "Номенклатура",
            СтрокаТовара.Номенклатура
        );

        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();

        Если Выборка.Следующий() Тогда
            КоличествоНаСкладе =
                Выборка.Количество;
        КонецЕсли;

        Если КоличествоНаСкладе < СтрокаТовара.Количество Тогда

            Сообщить(
                "Недостаточно товара: "
                + СтрокаТовара.Номенклатура
                + ". На складе: "
                + КоличествоНаСкладе
                + ", требуется: "
                + СтрокаТовара.Количество
            );

            Отказ = Истина;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
