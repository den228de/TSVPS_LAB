&НаСервере
Процедура ОбработкаПроведения(Отказ, Режим)
    ПроверитьОстатки(Отказ);
КонецПроцедуры

&НаСервере
Процедура ПроверитьОстатки(Отказ)
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ЭтотОбъект.Дата) Тогда
        Отказ = Истина;
        Сообщить("Не указана дата документа!");
        Возврат;
    КонецЕсли;

    Если ЭтотОбъект.Склад = Неопределено Тогда
        Отказ = Истина;
        Сообщить("Не указан склад!");
        Возврат;
    КонецЕсли;

    ТЗ = ЭтотОбъект.ПоступленияТоваров.Выгрузить();
    Если ТЗ.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   ТЧ.Номенклатура КАК Номенклатура,
        |   ТЧ.Количество КАК Количество
        |ПОМЕСТИТЬ НужноеКоличество
        |ИЗ
        |   &ТаблицаТоваров КАК ТЧ
        |;
        |
        |ВЫБРАТЬ
        |   НужноеКоличество.Номенклатура,
        |   СУММА(НужноеКоличество.Количество) КАК Требуется,
        |   СУММА(Остатки.КоличествоОстаток) КАК Остаток,
        |   СУММА(Резервы.Количество) КАК Резерв
        |ИЗ
        |   НужноеКоличество КАК НужноеКоличество
        |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, ) КАК Остатки
        |           ПО НужноеКоличество.Номенклатура = Остатки.Номенклатура
        |               И &Склад = Остатки.Склад
        |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыТоваров.Остатки(&Дата, ) КАК Резервы
        |           ПО НужноеКоличество.Номенклатура = Резервы.Номенклатура
        |               И &Склад = Резервы.Склад
        |               И Резервы.ДатаОкончания >= &Сейчас
        |СГРУППИРОВАТЬ ПО
        |   НужноеКоличество.Номенклатура";

    Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
    Запрос.УстановитьПараметр("Склад", ЭтотОбъект.Склад);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());
    Запрос.УстановитьПараметр("ТаблицаТоваров", ТЗ);

    Результат = Запрос.Выполнить().Выгрузить();

    Для Каждого Строка Из Результат Цикл
        Остаток = Строка.Остаток;
        Если Остаток = Неопределено Тогда
            Остаток = 0;
        КонецЕсли;

        Резерв = Строка.Резерв;
        Если Резерв = Неопределено Тогда
            Резерв = 0;
        КонецЕсли;

        Доступно = Остаток - Резерв;

        Если Строка.Требуется > Доступно Тогда
            Отказ = Истина;
            Сообщить("Недостаточно товара: " + Строка.Номенклатура +
                     ". Требуется: " + Строка.Требуется +
                     ", доступно: " + Доступно);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры


&НаСервере
Процедура ОбработкаПроведения(Отказ, Режим)
    ПроверитьОстатки(Отказ);
КонецПроцедуры

