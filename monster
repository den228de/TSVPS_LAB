Функция ПолучитьОстаток(Товар)

Если Товар = Неопределено Тогда
    Возврат 0;
КонецЕсли;

Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ
|   ЕСТЬNULL(СУММА(Товары.Количество), 0) КАК Остаток
|ИЗ
|   Документ.ПоступлениеТоваров.Товары КАК Товары
|ГДЕ
|   Товары.Номенклатура = &Товар";

Запрос.УстановитьПараметр("Товар", Товар);

Результат = Запрос.Выполнить().Выбрать();

Если Результат.Следующий() Тогда
    Возврат Результат.Остаток;
КонецЕсли;

Возврат 0;

КонецФункции


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

Для Каждого СтрокаТовара Из Товары Цикл

    Остаток = ПолучитьОстаток(
        СтрокаТовара.Номенклатура
    );

    Если Остаток < СтрокаТовара.Количество Тогда

        Сообщить(
            "Недостаточно товара: "
            + СтрокаТовара.Номенклатура
            + ". На складе: "
            + Строка(Остаток)
            + ". Требуется: "
            + Строка(СтрокаТовара.Количество)
        );

        Отказ = Истина;

    КонецЕсли;

КонецЦикла;

КонецПроцедуры
