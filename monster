
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Для Каждого СтрокаТовара Из Товары Цикл

        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            Продолжить;
        КонецЕсли;

        // Считаем общее количество товара в документе
        КоличествоВДокументе = 0;

        Для Каждого СтрокаПроверки Из Товары Цикл

            Если СтрокаПроверки.Номенклатура =
                СтрокаТовара.Номенклатура Тогда

                КоличествоВДокументе =
                    КоличествоВДокументе
                    + СтрокаПроверки.Количество;

            КонецЕсли;

        КонецЦикла;

        // Получаем остаток на выбранном складе
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   ЕСТЬNULL(
        |       СУММА(Остатки.КоличествоОстаток), 0
        |   ) КАК Остаток
        |ИЗ
        |   РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
        |ГДЕ
        |   Остатки.Номенклатура = &Товар
        |   И Остатки.Склад = &Склад";

        Запрос.УстановитьПараметр(
            "Товар",
            СтрокаТовара.Номенклатура
        );

        Запрос.УстановитьПараметр("Склад", Склад);

        Выборка = Запрос.Выполнить().Выбрать();

        Остаток = 0;

        Если Выборка.Следующий() Тогда
            Остаток = Выборка.Остаток;
        КонецЕсли;

        // Проверяем, хватает ли товара
        Если КоличествоВДокументе > Остаток Тогда

            Сообщить(
                "Недостаточно товара: "
                + Строка(СтрокаТовара.Номенклатура)
                + Символы.ПС
                + "Склад: " + Строка(Склад)
                + Символы.ПС
                + "Доступно: " + Строка(Остаток)
                + Символы.ПС
                + "Требуется: "
                + Строка(КоличествоВДокументе)
            );

            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
