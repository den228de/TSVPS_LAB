Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Для Каждого СтрокаТовара Из Товары Цикл

        Запрос = Новый Запрос;

        Запрос.Текст =
        "ВЫБРАТЬ
        |   ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
        |       КАК Остаток
        |ИЗ
        |   РегистрНакопления.ТоварыНаСкладах.Остатки(
        |       &Момент,
        |       Номенклатура = &Номенклатура
        |       И Склад = &Склад
        |   ) КАК Остатки";

        Запрос.УстановитьПараметр(
            "Момент",
            МоментВремени()
        );

        Запрос.УстановитьПараметр(
            "Номенклатура",
            СтрокаТовара.Номенклатура
        );

        Запрос.УстановитьПараметр(
            "Склад",
            Склад
        );

        Выборка = Запрос.Выполнить().Выбрать();

        Остаток = 0;

        Если Выборка.Следующий() Тогда
            Остаток = Выборка.Остаток;
        КонецЕсли;

        Если СтрокаТовара.Количество > Остаток Тогда

            Сообщить(
                "Недостаточно товара: "
                + Строка(СтрокаТовара.Номенклатура)
                + ". Остаток: "
                + Строка(Остаток)
                + ", требуется: "
                + Строка(СтрокаТовара.Количество)
            );

            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
