vector<vector<double>> weights2; // hiddenSize1 x hiddenSize2
    vector<vector<double>> weights3; // hiddenSize2 x outputSize
    // --- Параметры сети ---
    int inputSize;
    int hiddenSize1;
    int hiddenSize2;
    int outputSize;
    // --- Конструктор класса NeuralNetwork ---
    NeuralNetwork(int inputNodes, int hiddenNodes1, int hiddenNodes2, int outputNodes, double lr = 0.1) : inputSize(inputNodes), hiddenSize1(hiddenNodes1), hiddenSize2(hiddenNodes2), outputSize(outputNodes),learningRate(lr)
    {
        inputLayer.resize(inputNodes, 0.0);
        hiddenLayer1.resize(hiddenNodes1, 0.0);
        hiddenLayer2.resize(hiddenNodes2, 0.0);
        outputLayer.resize(outputNodes, 0.0);
        last_inputLayer.resize(inputNodes);
        last_hiddenLayer1.resize(hiddenNodes1);
        last_hiddenLayer2.resize(hiddenNodes2);
        random_device rd;
        mt19937 gen(rd());
        uniform_real_distribution<> dis(-0.5, 0.5); // Диапазон весов
        weights1.resize(inputNodes, vector<double>(hiddenNodes1));
        for (int i = 0; i < inputNodes; ++i) {
            for (int j = 0; j < hiddenNodes1; ++j) {
                weights1[i][j] = dis(gen);
            }
        }
        weights2.resize(hiddenNodes1, vector<double>(hiddenNodes2));
        for (int i = 0; i < hiddenNodes1; ++i) {
            for (int j = 0; j < hiddenNodes2; ++j) {
                weights2[i][j] = dis(gen);
            }
        }
        weights3.resize(hiddenSize2, vector<double>(outputNodes));
        for (int i = 0; i < hiddenSize2; ++i) {
            for (int j = 0; j < outputNodes; ++j) {
                weights3[i][j] = dis(gen);
            }
        }
    }
    // --- Метод прямого распространения ---
    void forwardPropagation(const vector<double>& input) {
        if (input.size() != inputSize) {
            cerr << "Ошибка: Количество входных данных (" << input.size()
                << ") не соответствует размеру входного слоя (" << inputSize << ")." << endl;
            return;
        }
        inputLayer = input;
        last_inputLayer = inputLayer;
        for (int j = 0; j < hiddenSize1; ++j) {
            double sum = 0.0;
            for (int i = 0; i < inputSize; ++i) {
                sum += inputLayer[i] * weights1[i][j];
            }
            hiddenLayer1[j] = sigmoid(sum);
        }
        last_hiddenLayer1 = hiddenLayer1;
        for (int j = 0; j < hiddenSize2; ++j) {
            double sum = 0.0;
            for (int i = 0; i < hiddenSize1; ++i) {
                sum += hiddenLayer1[i] * weights2[i][j];
            }
            hiddenLayer2[j] = sigmoid(sum);
        }
        last_hiddenLayer2 = hiddenLayer2;
        for (int j = 0; j < outputSize; ++j) {
            double sum = 0.0;
            for (int i = 0; i < hiddenSize2; ++i) {
                sum += hiddenLayer2[i] * weights3[i][j];
            }
            outputLayer[j] = sigmoid(sum);
        }
    }
    // --- Метод обратного распространения ошибки и обновления весов ---
    void backpropagate(const vector<double>& expectedOutput) {
        if (expectedOutput.size() != outputSize) {
            cerr << "Ошибка: Количество ожидаемых выходных данных не соответствует размеру выходного слоя." << endl;
            return;
        }
        vector<double> outputErrors(outputSize);
        for (int i = 0; i < outputSize; ++i) {
            double error = expectedOutput[i] - outputLayer[i];
            outputErrors[i] = error * sigmoidDerivative(outputLayer[i]);
        }
        vector<double> hiddenErrors2(hiddenSize2);
        for (int i = 0; i < hiddenSize2; ++i) {
            double error = 0.0;
            for (int j = 0; j < outputSize; ++j) {
                error += outputErrors[j] * weights3[i][j];
            }
            hiddenErrors2[i] = error * sigmoidDerivative(hiddenLayer2[i]);
        }
        vector<double> hiddenErrors1(hiddenSize1);
        for (int i = 0; i < hiddenSize1; ++i) {
            double error = 0.0;
            for (int j = 0; j < hiddenSize2; ++j) {
                error += hiddenErrors2[j] * weights2[i][j];
            }
            hiddenErrors1[i] = error * sigmoidDerivative(hiddenLayer1[i]);
        }
        // Обновляем веса weights3
        for (int i = 0; i < hiddenSize2; ++i) {
            for (int j = 0; j < outputSize; ++j) {
                weights3[i][j] += learningRate * outputErrors[j] * last_hiddenLayer2[i];
            }
        }
        // Обновляем веса weights2
        for (int i = 0; i < hiddenSize1; ++i) {
            for (int j = 0; j < hiddenSize2; ++j) {
                weights2[i][j] += learningRate * hiddenErrors2[j] * last_hiddenLayer1[i];
            }
        }
        // Обновляем веса weights1
        for (int i = 0; i < inputSize; ++i) {
            for (int j = 0; j < hiddenSize1; ++j) {
                weights1[i][j] += learningRate * hiddenErrors1[j] * last_inputLayer[i];
            }
        }
    }
    // --- Метод обучения сети на одном примере ---
    void train(const vector<double>& input, const vector<double>& expectedOutput, int epochs = 1000) {
        cout << "\n--- Начало обучения на одном примере ---" << endl;
        cout << "Ожидаемый выход (для обучения): ";
        for (double val : expectedOutput) cout << fixed << setprecision(4) << val << " ";
        cout << endl;
        // Вывод состояния сети и ошибки для эпохи 0 (до первого изменения весов)
        forwardPropagation(input);
        cout << "\n--- Эпоха 0/" << epochs << " ---" << endl;
        printState();
        double initialError = 0.0;
        for (int i = 0; i < outputSize; ++i) {
            initialError += pow(expectedOutput[i] - outputLayer[i], 2);
        }
        cout << "Ошибка: " << fixed << setprecision(6) << initialError << endl;
        // Основной цикл обучения
        for (int epoch = 1; epoch <= epochs; ++epoch) {
            forwardPropagation(input);
            backpropagate(expectedOutput);
            // Условие для вывода: первая эпоха (epoch == 1) ИЛИ эпоха кратна 100 ИЛИ последняя эпоха.
            if (epoch == 1 || epoch == epochs || (epoch % 100 == 0)) {
                cout << "\n--- Эпоха " << epoch << "/" << epochs << " ---" << endl;
                forwardPropagation(input); // Обновляем outputLayer с последними весами
                printState(); // Выводим состояние слоев
                double currentError = 0.0;
                for (int i = 0; i < outputSize; ++i) {
                    currentError += pow(expectedOutput[i] - outputLayer[i], 2);
                }
                cout << "Ошибка: " << fixed << setprecision(6) << currentError << endl;
            }
        }
        cout << "--- Обучение завершено ---" << endl;
    }
    // --- Функция: Прохождение одного шага (1 эпоха) с текущими весами ---
    void predictOneStep(const vector<double>& input) {
        cout << "\n--- Прохождение одного шага (1 эпоха) ---" << endl;
        cout << "Входные данные (для predictOneStep): ";
        for (double val : input) cout << fixed << setprecision(4) << val << " ";
        cout << endl;
        // Выполняем прямое распространение с текущими (обученными) весами.
        forwardPropagation(input);
        // Выводим состояние слоев после прохождения.
        printState();
        cout << "--- Прохождение одного шага завершено ---" << endl;
    }
    // Метод для вывода состояния слоев сети
    void printState() {
        cout << "Входной слой:" << endl;
        for (double val : inputLayer) {
            cout << fixed << setprecision(4) << val << " ";
        }
        cout << endl;
        cout << "\nСкрытый слой 1:" << endl;
        for (double val : hiddenLayer1) {
            cout << fixed << setprecision(4) << val << " ";
        }
        cout << endl;
        cout << "\nСкрытый слой 2:" << endl;
        for (double val : hiddenLayer2) {
            cout << fixed << setprecision(4) << val << " ";
        }
        cout << endl;
        cout << "\nВыходной слой (предсказание):" << endl;
        for (double val : outputLayer) {
            cout << fixed << setprecision(4) << val << " ";
        }
        cout << endl;
    }
    // --- Метод для вывода весов определенного слоя (для отладки) ---
    void printWeightsOfLayer(const vector<vector<double>>& weights, const string& layerName) {
        cout << "\nВеса " << layerName << ":" << endl;
        if (weights.empty()) {
            cout << "  (Нет весов для данного слоя)" << endl;
            return;
        }
        size_t rows = weights.size();
        size_t cols = weights[0].size();
        string sourceLayerName, destLayerName;
        if (&weights == &weights1) { // Сравниваем адреса матриц
            sourceLayerName = "Input Layer";
            destLayerName = "Hidden Layer 1";
        }
        else if (&weights == &weights2) {
            sourceLayerName = "Hidden Layer 1";
            destLayerName = "Hidden Layer 2";
        }
        else if (&weights == &weights3) {
            sourceLayerName = "Hidden Layer 2";
            destLayerName = "Output Layer";
        }
        else {
            sourceLayerName = "Unknown";
            destLayerName = "Unknown";
        }
        cout << "  (От " << sourceLayerName << " к " << destLayerName << ")" << endl;
        for (size_t i = 0; i < rows; ++i) {
            for (size_t j = 0; j < cols; ++j) {
                cout << "    w[" << i << "->" << j << "] = "
                    << fixed << setprecision(4) << weights[i][j] << endl;
            }
        }
    }
    // --- Публичные геттеры для весов, чтобы main мог их вызывать ---
    const vector<vector<double>>& getWeights1() const { return weights1; }
    const vector<vector<double>>& getWeights2() const { return weights2; }
    const vector<vector<double>>& getWeights3() const { return weights3; }
    // --- Публичные геттеры для размеров сети ---
    int getInputSize() const { return inputSize; }
    int getHiddenSize1() const { return hiddenSize1; }
    int getHiddenSize2() const { return hiddenSize2; }
    int getOutputSize() const { return outputSize; }
    // --- Публичный метод для получения текущего outputLayer ---
    const vector<double>& getOutputLayer() const { return outputLayer; }
};
int main() {
    system("color 0A");
    setlocale(LC_ALL, "Russian");
    // Создаем нейронную сеть: входной слой, 1 скрытый слой, 2 скрытый слой, выходной слой, скорость обучения (learningRate) = 0.1.
    NeuralNetwork nn(10, 100, 100, 10, 0.1);
    // Обучающий пример
    vector<double> trainingInput = { 0.82, 0.68, 0.58, 0.52, 0.5, 0.52, 0.58, 0.68, 0.82, 1 };
    vector<double> trainingExpectedOutput = { 0.82, 0.68, 0.58, 0.52, 0.5, 0.52, 0.58, 0.68, 0.82, 1 };
    // Обучаем сеть (входные данные, ожидаемые выходные данные, количество эпох(циклов))
    nn.train(trainingInput, trainingExpectedOutput, 500);
    cout << "\n--- Финальное состояние сети после обучения ---" << endl;
    nn.forwardPropagation(trainingInput); // Обновляем outputLayer для финального вывода
    nn.printState();
    // Сохраняем предсказание для обучающего примера, чтобы вывести его в сводной информации
    vector<double> finalPredictionForTraining = nn.getOutputLayer();
    // --- Проверка на новых входных данных ---
    vector<double> newTestData = { 0.28, -0.28, -0.68, -0.92, -1.0, -0.92, -0.68, -0.28, 0.28, 1.0 };
    // Используем predictOneStep, чтобы получить предсказание
    nn.predictOneStep(newTestData);
    // Сохраняем предсказание для predictOneStep
    vector<double> predictionFromPredictOneStep = nn.getOutputLayer();
    // --- Сводная информация в конце ---
    cout << "\n==========================================" << endl;
    cout << "         Сводная информация" << endl;
    cout << "==========================================" << endl;
    // Информация для обучения
    cout << "\n--- Сводка по ОБУЧЕНИЮ ---" << endl;
    cout << "Количество нейронов: Вход=" << nn.getInputSize()
        << ", Скрытый1=" << nn.getHiddenSize1()
        << ", Скрытый2=" << nn.getHiddenSize2()
        << ", Выход=" << nn.getOutputSize() << endl;
    cout << "Входные данные: ";
    for (double val : trainingInput) cout << fixed << setprecision(4) << val << " ";
    cout << endl;
    cout << "Ожидаемый результат: ";
    for (double val : trainingExpectedOutput) cout << fixed << setprecision(4) << val << " ";
    cout << endl;
    cout << "Финальное предсказание: ";
    for (double val : finalPredictionForTraining) cout << fixed << setprecision(4) << val << " ";
    cout << endl;
    // Информация для predictOneStep
    cout << "\n--- Сводка по predictOneStep ---" << endl;
    cout << "Входные данные: ";
    for (double val : newTestData) cout << fixed << setprecision(4) << val << " ";
    cout << endl;
    cout << "Предсказание: ";
    for (double val : predictionFromPredictOneStep) cout << fixed << setprecision(4) << val << " ";
    cout << "\n==========================================" << endl;
    return 0;
