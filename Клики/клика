    }
    vector<int> maxcliq = findmaxcliq(a);
    cout << "Максимальная клика в графе" << endl;
    cout << "Размер клики: " << maxcliq.size() << endl;
    cout << "Вершины клики: ";
    for (size_t i = 0; i < maxcliq.size(); ++i) {
        cout << maxcliq[i] << (i == maxcliq.size() - 1 ? "" : ", ");
    }
    cout << endl;
    drawGraph(a, cliq, maxcliq);
    return 0;
}
