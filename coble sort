void drawGR(RenderWindow& window, vector<double> acergr, vector<double> acergr1, double max, int n) {
    window.clear(); // очищаем окно перед рендером
    for (const auto& value : acergr) {
        if (value >= max) {
            max = value;
        }
    }
    for (const auto& value : acergr1) {
        if (value >= max) {
            max = value;
        }
    }
    max *= 1.005f;
    // получаем размеры окна
    Vector2u size = window.getSize();
    // настраиваем шрифт
    Font font;
    if (!font.loadFromFile("C:\\Users\\user.VC\\Downloads\\ArialRegular.ttf")) {
        cerr << "Could not load font!" << endl;
        return;
    }
    // создаём списки элементов для обоих графиков
    vector<CircleShape> points1(n);   // круги для первого набора данных
    vector<CircleShape> points2(n);   // круги для второго набора данных
    vector<Text> labels1(n * 2);          // подписи значений для первого набора
    vector<Vertex> lineVertices1(n);  // вершины линии для первого набора
    vector<Vertex> lineVertices2(n);  // вершины линии для второго набора
    vector<Vertex> gridLines(4); // Две вершины на каждую линию
    vector<Text> labelss3(n);
    for (int i = 0; i < 10; ++i) {
        string d = to_string(max * ((10.f * (i + 1)) / 100));
        labels1[i].setString(d.substr(0, 3)); // подпись значения
        labels1[i].setFont(font);
        labels1[i].setCharacterSize(15);
        labels1[i].setFillColor(Color::Blue);
        labels1[i].setPosition(16, (size.y - 67) - ((i + 1) * (size.y * (9.f / 100))));
    }
    // рисование первого графика
    for (int i = 0; i < n; ++i) {
        float x; // отступы по краям
        if (i == 0)
        {
            x = static_cast<float>(1) / (n)*size.x * (0.5);
        }
        else
        {
            x = static_cast<float>(i) / (n)*size.x * (1);
        }
        float y = (1.f - acergr[i] / max)
            * (size.y * (90.f / 100));     // масштабируем относительно максимума
        points1[i].setRadius(5);
        points1[i].setFillColor(Color::Red);                        // красный цвет для первого набора
        points1[i].setPosition(x - 5, y + 10);
        string s = to_string(2 * (i + 1));
        labelss3[i].setString(s);
        labelss3[i].setFont(font);
        labelss3[i].setCharacterSize(15); // Размер шрифта
        labelss3[i].setFillColor(Color::Red);
        labelss3[i].setPosition(x - 10, size.y - 55);
        lineVertices1[i].position = { x, y + 15 };                       // задаём позицию вершины
        lineVertices1[i].color = Color::Blue;
    }
    // рисование второго графика
    for (int i = 0; i < n; ++i) {
        float x; // отступы по краям
        if (i == 0)
        {
            x = static_cast<float>(1) / (n)*size.x * (0.5);

        }
        else
        {
            x = static_cast<float>(i) / (n)*size.x * (1);
        }
        float y = (1.f - acergr1[i] / max) * (size.y * (90.f / 100));   // аналогично первому графику
        points2[i].setRadius(5);
        points2[i].setFillColor(Color::Green);                     // зелёный цвет для второго набора
        points2[i].setPosition(x - 5, y + 10);
        lineVertices2[i].position = { x, y + 15 };
        lineVertices2[i].color = Color::Magenta;                    // фиолетовый цвет линии
    }
    gridLines[0].position = sf::Vector2f(0, size.y - 57);
    gridLines[0].color = sf::Color::Blue;
    gridLines[1].position = sf::Vector2f(size.x, size.y - 57);
    gridLines[1].color = sf::Color::Blue;
    gridLines[2].position = sf::Vector2f(40, 0);
    gridLines[2].color = sf::Color::Blue;
    gridLines[3].position = sf::Vector2f(40, size.y);
    gridLines[3].color = sf::Color::Blue;
    Text zero;
    zero.setString("0"); // подпись значения
    zero.setFont(font);
    zero.setCharacterSize(15);
    zero.setFillColor(Color::Red);
    zero.setPosition(25, size.y - 55);
    window.draw(gridLines.data(), gridLines.size(), Lines);
    window.draw(zero);
    window.draw(&lineVertices1[0], lineVertices1.size(), LinesStrip); // линия первого графика
    window.draw(&lineVertices2[0], lineVertices2.size(), LinesStrip); // линия второго графика
    for (const auto& point : points1) {
        window.draw(point);                                         // точки первого графика
    }
    for (const auto& point : points2) {
        window.draw(point);                                         // точки второго графика
    }
    for (const auto& label : labels1) {
        window.draw(label);                                        // подписи первого графика
    }
    for (const auto& label : labelss3)
    {
        window.draw(label);
    }
}
pair<vector<int>, vector<int>> per(vector<int> kamni, int n)
{
    long long tot = accumulate(kamni.begin(), kamni.end(), 0);
    long long min = LLONG_MAX;
    pair<vector<int>, vector<int>> best({}, {});
    for (long long j = 0; j < (1LL << n); ++j)
    {
        vector<int>  gr, gr1;
        long long sum = 0, sum1 = 0;
        for (int i = 0; i < n; ++i)
        {
            if ((j >> i) & 1) {
                gr.push_back(kamni[i]);
                sum += kamni[i];
            }
            else {
                gr1.push_back(kamni[i]);
                sum1 += kamni[i];
            }
        }
        long long diff = abs(sum - sum1);
        if (diff < min) {
            min = diff;
            best = make_pair(gr, gr1);
        }
    }
    return best;
}
